{
  "manifest_version": 3,
  "name": "Chat2PDF",
  "version": "1.0.0",
  "description": "Chat2PDF — Save ChatGPT responses as beautifully formatted PDF notes with one click!",
  "permissions": ["storage", "activeTab", "clipboardRead", "downloads"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "css": ["content-styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/html2pdf.bundle.min.js", "preview.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
